{
  "name": "@ai-gateway/trace-receiver",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "链路接收端（内网）：OTLP/HTTP JSON 接收 → 批量写 PG 日分区；过载即丢绝不反压业务",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --sourcemap --outdir=dist",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun x vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "lint": "bun x oxlint"
  },
  "dependencies": {
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/http": "workspace:*",
    "@ai-gateway/tracing": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
