# syntax=docker/dockerfile:1
# 服务端统一镜像（gateway / worker / admin-api / client-api / trace-receiver），compose 通过 build arg APP 指定
# 构建段：全 bun；全量 bundle（无 --packages=external）→ dist 自包含
# 运行段：仅 dist（零 node_modules/packages——符号链接布局坑整体退场，镜像 ~40MB）
FROM oven/bun:1.4-alpine AS builder
ARG APP
WORKDIR /repo
COPY package.json bun.lock tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --frozen-lockfile
# 尾部 ... = 含依赖图（bun --filter 默认只跑本包；bundle 从 workspace 源码取依赖，此处保守保留）
RUN bun run --filter "@ai-gateway/${APP}..." build \
  && mkdir -p /out \
  && cp -r "apps/${APP}/dist" /out/dist

FROM oven/bun:1.4-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /out/dist ./dist
CMD ["bun", "dist/index.js"]
